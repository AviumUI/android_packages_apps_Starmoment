android_app_import {
    name: "Starmoment",
    apk: "Starmoment.apk",
    presigned: true, 
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
    system_ext_specific: true,
    required: ["privapp-permissions-com.star.moment.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-com.star.moment.xml",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-com.star.moment.xml",
    filename_from_src: true,
}
